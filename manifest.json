{
  "manifest_version": 3,
  "name": "DarkExtension",
  "version": "1.0.0",
  "description": "Universal dark mode for every website — curated themes for Amazon, eBay, and major sites, adaptive dynamic engine, native dark mode detection, and customizable presets.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DarkExtension — Universal Dark Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle dark mode on the current site"
    },
    "toggle-global": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Toggle DarkExtension globally"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/themes/base/*.css",
        "src/themes/sites/*.css",
        "src/themes/sites/registry.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/shared/constants.js",
        "src/shared/site-matcher.js",
        "src/shared/color-utils.js",
        "src/shared/schedule.js",
        "src/shared/storage.js",
        "src/content/early-inject.js",
        "src/content/detector.js",
        "src/content/dynamic-engine.js",
        "src/content/content.js"
      ]
    }
  ]
}
